APP_URL=http://localhost

GUEST_PORTAL_MAGIC_LINK_TTL=10080
GUEST_PORTAL_SESSION_TTL=1440
RESERVATION_HOLD_TTL_MINUTES=30
SANCTUM_EXPIRATION=1440
ALLOW_DEMO_SEEDING=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
